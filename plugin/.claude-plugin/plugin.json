{
  "name": "content-producer",
  "version": "0.1.8",
  "description": "像素级复刻公众号/小红书爆款，结合当前项目产品生成图文并发布的内容生产插件（主skill编排 + 多sub-agent + MCP）。",
  "author": {
    "name": "jesonliu",
    "url": "https://github.com/JesonMrLiu/content-producer"
  },
  "license": "MIT",
  "keywords": ["content", "wechat", "xiaohongshu", "replicate", "publish", "image-generation", "image-recognition"],
  "mcpServers": {
    "image-recognition": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@jesonliu/image-recognition-mcp"],
      "env": {
        "IMAGE_RECOGNITION_API_KEY": "${IMAGE_RECOGNITION_API_KEY}",
        "IMAGE_RECOGNITION_BASE_URL": "${IMAGE_RECOGNITION_BASE_URL}",
        "IMAGE_RECOGNITION_MODEL": "${IMAGE_RECOGNITION_MODEL}",
        "IMAGE_RECOGNITION_DETAIL": "${IMAGE_RECOGNITION_DETAIL:-high}",
        "IMAGE_RECOGNITION_MAX_TOKENS": "${IMAGE_RECOGNITION_MAX_TOKENS:-2048}",
        "IMAGE_RECOGNITION_TIMEOUT_MS": "${IMAGE_RECOGNITION_TIMEOUT_MS:-60000}",
        "IMAGE_RECOGNITION_DOWNLOAD_URL": "${IMAGE_RECOGNITION_DOWNLOAD_URL:-0}",
        "IMAGE_RECOGNITION_MAX_FILE_MB": "${IMAGE_RECOGNITION_MAX_FILE_MB:-15}"
      }
    },
    "generate-image": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@jesonliu/generate-image-mcp-server"],
      "env": {
        "IMAGE_GEN_API_KEY": "${IMAGE_GEN_API_KEY}",
        "IMAGE_GEN_BASE_URL": "${IMAGE_GEN_BASE_URL}",
        "IMAGE_GEN_MODEL": "${IMAGE_GEN_MODEL}",
        "IMAGE_GEN_SIZE": "${IMAGE_GEN_SIZE:-1024x1024}",
        "IMAGE_GEN_TIMEOUT_MS": "${IMAGE_GEN_TIMEOUT_MS:-120000}",
        "IMAGE_GEN_WATERMARK_PARAM": "${IMAGE_GEN_WATERMARK_PARAM:-watermark_enabled}"
      }
    },
    "publish": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@jesonliu/publish-mcp-server"],
      "env": {
        "WECHAT_APP_ID": "${WECHAT_APP_ID}",
        "WECHAT_APP_SECRET": "${WECHAT_APP_SECRET}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
